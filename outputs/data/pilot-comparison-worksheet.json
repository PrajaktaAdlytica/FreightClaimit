      "key": "case_id",
      "label": "Pseudonymous ID",
      "guidance": "Required for matched baseline and pilot records"
    },
    {
      "key": "carrier_mode",
      "label": "Carrier/mode",
      "guidance": "Restrict first pilot to agreed scope"
    },
    {
      "key": "claimant_standing",
      "label": "Standing status + source",
      "guidance": "Professional validation; not inferred"
    },
    {
      "key": "contract_version",
      "label": "Applicable version + owner",
      "guidance": "Missing source blocks deadline interpretation"
    },
    {
      "key": "data_authority",
      "label": "Document access/processing permission",
      "guidance": "Separate from legal standing"
    },
    {
      "key": "current_software",
      "label": "Existing FreightClaims/TMS/manual/portal workflow",
      "guidance": "Baseline named, configuration recorded"
    },
    {
      "key": "case_open_closed",
      "label": "Open or closed",
      "guidance": "Avoid mixing time-to-outcome cohorts"
    },
    {
      "key": "documents_present",
      "label": "Required/present/missing/illegible/contradictory/N/A counts",
      "guidance": "Applicability determined per case"
    },
    {
      "key": "uncertain_ocr_fields",
      "label": "Field IDs, source and confidence",
      "guidance": "Review burden and corrections recorded"
    },
    {
      "key": "deadline_verification_owner",
      "label": "Named owner + status",
      "guidance": "Unknown stays unknown"
    },
    {
      "key": "baseline_prep_minutes",
      "label": "Observed minutes",
      "guidance": "Include retrieval, chase and review work consistently"
    },
    {
      "key": "pilot_prep_minutes",
      "label": "Observed minutes",
      "guidance": "Include audit/review overhead; same timing rules"
    },
    {
      "key": "reviewer_corrections",
      "label": "Count, type, false flags and source",
      "guidance": "Do not reward spurious gap counts"
    },
    {
      "key": "incremental_gaps",
      "label": "Useful gaps beyond baseline, adjudicated",
      "guidance": "Primary reason to pay, not raw alert volume"
    },
    {
      "key": "deficiency_count",
      "label": "Returns/requests for missing material",
      "guidance": "Use known outcomes and a defined observation period"
    },
    {
      "key": "submitted_amount",
      "label": "Verified value + currency + source + date",
      "guidance": "Null when unknown/not submitted"
    },
    {
      "key": "recovered_amount",
      "label": "Verified value + currency + source + date",
      "guidance": "Separate zero from unknown; record attribution limitations"
    },
    {
      "key": "pilot_fee",
      "label": "Agreed/paid fee + evidence status",
      "guidance": "No payment processing in public demo"
    },
    {
      "key": "buyer_decision",
      "label": "Proceed / pivot / stop + reason",
      "guidance": "Named budget owner and next commitment"
    }
  ],
