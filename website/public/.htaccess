DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Preserve real files and directories, including assets and the planning pages.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Missing assets must be a 404, not an HTML response disguised as JS or an image.
  RewriteRule ^(?:assets|brand|downloads)/ - [L]
  RewriteRule \.[a-zA-Z0-9]{1,8}$ - [L]
  # BrowserRouter deep links are handled by React.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
